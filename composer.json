{
    "name": "fof/mailing",
    "description": "Send individual or mass mailing to Flarum users",
    "keywords": [
        "extension",
        "flarum",
        "email",
        "mailing",
        "mass-mailing"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0.0"
    },
    "replace": {
        "kilowhat/flarum-ext-mailing": "*",
        "clarkwinkelmann/flarum-ext-mailing": "*"
    },
    "authors": [
        {
            "name": "Clark Winkelmann",
            "homepage": "https://clarkwinkelmann.com/",
            "email": "clark.winkelmann@gmail.com",
            "role": "Original developer"
        },
        {
            "name": "IanM",
            "email": "ian@flarum.org",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/mailing/issues",
        "source": "https://github.com/FriendsOfFlarum/mailing",
        "forum": "https://discuss.flarum.org/d/39128"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Mailing\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Mailing",
            "category": "feature",
            "icon": {
                "name": "fas fa-envelope",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof/user-directory"
            ]
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/20443"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/testing": "^2.0.0",
        "fof/user-directory": "^2.0.0"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\Mailing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
